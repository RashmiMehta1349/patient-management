# Server
PORT=3000
NODE_ENV=development

# Set to "true" in production behind a TLS-terminating reverse proxy (nginx, etc.)
TRUST_PROXY=false
# Set to "false" ONLY for local development without TLS. Must be "true" (default) in production.
FORCE_HTTPS=true

# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://user:pass@localhost:5432/pma_dev"

# Secret used to sign session JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_JWT_SECRET="replace-with-a-long-random-secret"

# Inactivity timeout: session is rejected if idle longer than this (minutes).
# Confirmed default per Product Owner: 15 minutes.
SESSION_INACTIVITY_TIMEOUT_MINUTES=15

# Hard ceiling on session lifetime regardless of activity (defense in depth).
SESSION_HARD_TTL_HOURS=12

# Password reset token expiry (minutes).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# bcrypt cost factor
BCRYPT_COST_FACTOR=12

# Allowed CORS origin for the Angular frontend
CORS_ORIGIN="http://localhost:4200"

# --- Seed script (single pre-provisioned doctor account) ---
SEED_DOCTOR_EMAIL="doctor@example.com"
SEED_DOCTOR_PASSWORD="ChangeMe123!"
